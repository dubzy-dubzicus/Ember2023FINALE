@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Download";
    ViewData["Active"] = "download";
    Layout = "_Layout";
}

<section class="download-hero">
    <div class="container">
        <div class="eyebrow" style="justify-content:center">Client access</div>
        <h1>Play on <span class="gradient-text">every device</span></h1>
        <p>Ember Network runs on self-hosted infrastructure. Builds are distributed by server admins — choose your platform to see the current setup notes.</p>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="section-head">
            <div>
                <h2 class="section-title">Supported platforms</h2>
                <p class="section-subtitle">The PC client is the primary build. Other platforms depend on community patches and device availability.</p>
            </div>
            <span class="status-pill"><span class="pulse-dot"></span>Server online</span>
        </div>

        <div class="platforms-grid">
            <div class="platform-card platform-featured">
                <span class="platform-ribbon">Primary</span>
                <div class="platform-icon">🖥️</div>
                <h3>Windows PC</h3>
                <p>Full 2023 client with Ember patch and voice support.</p>
                <button type="button" class="btn btn-primary" data-platform="Windows PC">View setup</button>
            </div>
            <div class="platform-card platform-featured">
                <span class="platform-ribbon">VR</span>
                <div class="platform-icon">🥽</div>
                <h3>Oculus Quest</h3>
                <p>Standalone VR build using the Ember package and native hooks.</p>
                <button type="button" class="btn btn-primary" data-platform="Oculus Quest">View setup</button>
            </div>
            <div class="platform-card">
                <div class="platform-icon">🎮</div>
                <h3>Oculus Rift</h3>
                <p>PC VR headset via the Windows client.</p>
                <button type="button" class="btn btn-secondary" data-platform="Oculus Rift">View setup</button>
            </div>
            <div class="platform-card">
                <div class="platform-icon">🍍</div>
                <h3>Pico</h3>
                <p>Standalone VR headset support varies by build.</p>
                <button type="button" class="btn btn-secondary" data-platform="Pico">View setup</button>
            </div>
            <div class="platform-card">
                <div class="platform-icon">🍎</div>
                <h3>iOS</h3>
                <p>Mobile client availability depends on current packages.</p>
                <button type="button" class="btn btn-secondary" data-platform="iOS">View setup</button>
            </div>
            <div class="platform-card">
                <div class="platform-icon">🤖</div>
                <h3>Android</h3>
                <p>Mobile client availability depends on current packages.</p>
                <button type="button" class="btn btn-secondary" data-platform="Android">View setup</button>
            </div>
            <div class="platform-card">
                <div class="platform-icon">🕹️</div>
                <h3>Nintendo Switch</h3>
                <p>Community build support is limited.</p>
                <button type="button" class="btn btn-secondary" data-platform="Nintendo Switch">View setup</button>
            </div>
            <div class="platform-card">
                <div class="platform-icon">⭕</div>
                <h3>Xbox</h3>
                <p>Community build support is limited.</p>
                <button type="button" class="btn btn-secondary" data-platform="Xbox">View setup</button>
            </div>
            <div class="platform-card">
                <div class="platform-icon">🎯</div>
                <h3>PlayStation</h3>
                <p>Community build support is limited.</p>
                <button type="button" class="btn btn-secondary" data-platform="PlayStation">View setup</button>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <div class="eyebrow">Quick start</div>
                <h2 class="section-title">Three steps to join</h2>
                <p class="section-subtitle">The client points at the same public address as this website.</p>
            </div>
        </div>
        <div class="steps-grid">
            <div class="step-card">
                <div class="step-number">1</div>
                <h3>Get the client</h3>
                <p>Ask a server admin for the current PC or Quest package. Do not use the stock rec.net client.</p>
            </div>
            <div class="step-card">
                <div class="step-number">2</div>
                <h3>Confirm the server URL</h3>
                <p>Your EmberPatch.cfg must point at <span class="code-pill" data-copy="https://ember.tail298318.ts.net" data-copy-message="Server URL copied.">https://ember.tail298318.ts.net</span>.</p>
            </div>
            <div class="step-card">
                <div class="step-number">3</div>
                <h3>Pick a room</h3>
                <p>Browse rooms on this site, then join from the client. Photon uses the configured cloud app IDs.</p>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="panel">
            <div class="eyebrow">Need help?</div>
            <h2 class="section-title">Builds are admin-distributed</h2>
            <p class="section-subtitle">This site intentionally does not host unofficial binaries. Copy the server address and ask an admin for the matching client package.</p>
            <div class="room-actions">
                <button type="button" class="btn btn-primary" data-copy="https://ember.tail298318.ts.net" data-copy-message="Server URL copied.">
                    <svg class="icon"><use href="#i-copy"></use></svg>Copy server URL
                </button>
                <a href="/Search?tab=rooms" class="btn btn-secondary">
                    <svg class="icon"><use href="#i-room"></use></svg>Browse rooms
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/download.js" asp-append-version="true"></script>
}
