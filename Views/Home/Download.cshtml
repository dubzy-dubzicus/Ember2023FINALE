@{
    ViewData["Title"] = "Download";
    Layout = "_Layout";
}

<section class="download-hero">
    <div class="container">
        <h1>Rec Room for Every Device</h1>
        <p>Download Ember Network client and join the self-hosted Rec Room community on your favorite platform.</p>
    </div>
</section>

<section class="platforms-grid">
    <div class="container">
        <div class="platform-card">
            <div class="platform-icon">🍎</div>
            <h3>iOS</h3>
            <p>Requires iOS 10.5 or later</p>
            <a href="#" class="btn btn-primary" style="display:block; margin-top:15px;">Download</a>
        </div>
        <div class="platform-card">
            <div class="platform-icon">🤖</div>
            <h3>Android</h3>
            <p>Requires Android 7.0 or later</p>
            <a href="#" class="btn btn-primary" style="display:block; margin-top:15px;">Download</a>
        </div>
        <div class="platform-card">
            <div class="platform-icon">🎮</div>
            <h3>Oculus Quest</h3>
            <p>Standalone VR headset</p>
            <a href="#" class="btn btn-primary" style="display:block; margin-top:15px;">Download</a>
        </div>
        <div class="platform-card">
            <div class="platform-icon">🥽</div>
            <h3>Oculus Rift</h3>
            <p>PC VR headset</p>
            <a href="#" class="btn btn-primary" style="display:block; margin-top:15px;">Download</a>
        </div>
        <div class="platform-card">
            <div class="platform-icon">🍍</div>
            <h3>Pico</h3>
            <p>Standalone VR headset</p>
            <a href="#" class="btn btn-primary" style="display:block; margin-top:15px;">Download</a>
        </div>
        <div class="platform-card">
            <div class="platform-icon">🕹️</div>
            <h3>Nintendo Switch</h3>
            <p>Hybrid console</p>
            <a href="#" class="btn btn-primary" style="display:block; margin-top:15px;">Download</a>
        </div>
        <div class="platform-card">
            <div class="platform-icon">⭕</div>
            <h3>Xbox</h3>
            <p>Xbox One, Series X|S</p>
            <a href="#" class="btn btn-primary" style="display:block; margin-top:15px;">Download</a>
        </div>
        <div class="platform-card">
            <div class="platform-icon">🎮</div>
            <h3>PlayStation</h3>
            <p>PS4, PS5</p>
            <a href="#" class="btn btn-primary" style="display:block; margin-top:15px;">Download</a>
        </div>
        <div class="platform-card">
            <div class="platform-icon">💨</div>
            <h3>Steam (PC)</h3>
            <p>Windows PC via Steam</p>
            <a href="#" class="btn btn-primary" style="display:block; margin-top:15px;">Download</a>
        </div>
    </div>
</section>
