@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var active = ViewData["Active"] as string;
    if (string.IsNullOrEmpty(active)) { active = ""; }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070b18" />
    <meta name="description" content="Ember Network — a self-hosted Rec Room community. Explore rooms, players, inventions, and news." />
    <title>@ViewData["Title"] - Ember Network</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <svg aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden" xmlns="http://www.w3.org/2000/svg">
        <symbol id="i-home" viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5" /><path d="M5.5 10.5V20h13v-9.5" /></symbol>
        <symbol id="i-news" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 8h10M7 12h6M7 16h10" /></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></symbol>
        <symbol id="i-download" viewBox="0 0 24 24"><path d="M12 3v12m0 0 4-4m-4 4-4-4" /><path d="M4 19h16" /></symbol>
        <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3" /><path d="M3.5 19c.6-3 2.6-4.5 5.5-4.5s4.9 1.5 5.5 4.5" /><path d="M16 5.5a3 3 0 0 1 0 5.5M17 14.8c2 .5 3.2 1.9 3.6 4.2" /></symbol>
        <symbol id="i-play" viewBox="0 0 24 24"><path d="m8 5 11 7-11 7z" /></symbol>
        <symbol id="i-sparkles" viewBox="0 0 24 24"><path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" /><path d="m19 16 .7 1.9L21.5 19l-1.8.7L19 21.5l-.7-1.8L16.5 19l1.8-1.1z" /></symbol>
        <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h15m0 0-5-5m5 5-5 5" /></symbol>
        <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4.5 20c.8-4 3.5-6 7.5-6s6.7 2 7.5 6" /></symbol>
        <symbol id="i-copy" viewBox="0 0 24 24"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3" /></symbol>
        <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" /></symbol>
        <symbol id="i-room" viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5z" /><path d="m3 8 9 5 9-5v8l-9 5-9-5z" /></symbol>
        <symbol id="i-zap" viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z" /></symbol>
        <symbol id="i-heart" viewBox="0 0 24 24"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21l8.8-8.3a5 5 0 0 0 0-7.1z" /></symbol>
        <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 4.5 6v5.5c0 4.6 3 8.1 7.5 9.5 4.5-1.4 7.5-4.9 7.5-9.5V6z" /><path d="m9 12 2 2 4-4" /></symbol>
    </svg>

    <header class="site-header">
        <div class="container">
            <a href="/" class="logo" aria-label="Ember Network home">
                <span class="logo-mark">E</span>
                <span class="logo-text">Ember<b>Network</b><small>community server</small></span>
            </a>

            <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false">
                <svg class="icon icon-lg"><use href="#i-users"></use></svg>
            </button>

            <nav class="main-nav">
                <a href="/" class="nav-link @(active == "home" ? "active" : "")">
                    <svg class="icon"><use href="#i-home"></use></svg>Home
                </a>
                <a href="/News" class="nav-link @(active == "news" ? "active" : "")">
                    <svg class="icon"><use href="#i-news"></use></svg>News
                </a>
                <a href="/Search" class="nav-link @(active == "search" ? "active" : "")">
                    <svg class="icon"><use href="#i-search"></use></svg>Explore
                </a>
                <a href="/Download" class="nav-link @(active == "download" ? "active" : "")">
                    <svg class="icon"><use href="#i-download"></use></svg>Download
                </a>
                <span class="status-pill"><span class="pulse-dot"></span>Server online</span>
                <a href="/Download" class="nav-link nav-cta">
                    <svg class="icon"><use href="#i-zap"></use></svg>Get client
                </a>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a href="/" class="logo">
                        <span class="logo-mark">E</span>
                        <span class="logo-text">Ember<b>Network</b></span>
                    </a>
                    <p>A community-run Rec Room server with rooms, inventions, profiles, and news — hosted on infrastructure we control.</p>
                </div>
                <div class="footer-col">
                    <h4>Explore</h4>
                    <a href="/Search?tab=rooms">Rooms</a>
                    <a href="/Search?tab=people">Players</a>
                    <a href="/Search?tab=inventions">Inventions</a>
                    <a href="/News">News</a>
                </div>
                <div class="footer-col">
                    <h4>Community</h4>
                    <a href="/Profile/dubzy">Coach Dubzy</a>
                    <a href="/Home/Index#community">Top creators</a>
                    <a href="/Home/Index#rooms">Featured rooms</a>
                    <a href="/Download">Client setup</a>
                </div>
                <div class="footer-col">
                    <h4>Network</h4>
                    <a href="/api/health/v1/status">Server status</a>
                    <a href="/api/health/v1/ping">Ping</a>
                    <a href="/api/health/v1/metrics">Metrics</a>
                    <span class="status-pill"><span class="pulse-dot"></span>Cloud linked</span>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; 2026 Ember Network. Not affiliated with Rec Room Inc.</span>
                <span>Built for the community · Powered by Ember</span>
            </div>
        </div>
    </footer>

    <div class="toast-stack" id="toastStack" aria-live="polite"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
