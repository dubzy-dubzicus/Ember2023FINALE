/* ============================================================== auth ======
   The site logs in against the same accounts the game uses - there is no
   second user store. POST /auth/connect/token is gated by CheckModGate,
   which rejects any request missing X-EMBER-Build, and then requires either a
   Steam id or platform=Oculus. A browser has no Steam id, so this sends
   platform=Oculus, which is the server's own Quest-client path: no placeholder
   id, and nothing to trip the Steam blacklist on. */
var TOKEN_KEY = 'ember.token';
var session = null;

function readToken(){ try { return localStorage.getItem(TOKEN_KEY); } catch(e){ return null; } }
function writeToken(t){
  try { t ? localStorage.setItem(TOKEN_KEY, t) : localStorage.removeItem(TOKEN_KEY); } catch(e){}
}

function openLogin(){
  document.getElementById('loginErr').className = 'err';
  document.getElementById('scrim').classList.add('open');
  setTimeout(function(){ document.getElementById('lu').focus(); }, 0);
}
function closeLogin(){ document.getElementById('scrim').classList.remove('open'); }

function loginError(msg){
  var e = document.getElementById('loginErr');
  e.textContent = msg;
  e.className = 'err show';
}

function doLogin(){
  var u = document.getElementById('lu').value.trim();
  var p = document.getElementById('lp').value;
  if(!u || !p){ loginError('Enter a username and password.'); return; }

  var btn = document.getElementById('loginBtn');
  btn.disabled = true;
  btn.textContent = 'Logging in...';

  var body = new URLSearchParams();
  body.set('grant_type', 'password');
  body.set('username', u);
  body.set('password', p);
  body.set('client_id', 'Ember');
  body.set('scope', '1');
  body.set('platform', 'Oculus');

  fetch('/auth/connect/token', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/x-www-form-urlencoded',
      'X-EMBER-Build': '1.0.5'
    },
    body: body.toString()
  })
  .then(function(r){ return r.json().then(function(j){ return { ok: r.ok, j: j }; }); })
  .then(function(res){
    if(!res.ok || !res.j.access_token){
      var d = res.j || {};
      loginError(d.error_description || d.error || 'Login failed.');
      btn.disabled = false;
      btn.textContent = 'Log in';
      return;
    }
    writeToken(res.j.access_token);
    document.getElementById('lp').value = '';
    closeLogin();
    loadSession();
    if(tab === 'photos') loadPhotos();
  })
  .catch(function(){
    loginError('Could not reach the server.');
    btn.disabled = false;
    btn.textContent = 'Log in';
  });
}

function logout(){
  writeToken(null);
  session = null;
  renderAuth();
  if(tab === 'photos') loadPhotos();
}

function loadSession(){
  var t = readToken();
  if(!t){ session = null; renderAuth(); return; }

  fetch('/acc/account/me', { headers: { 'Authorization': 'Bearer ' + t } })
    .then(function(r){ return r.ok ? r.json() : null; })
    .then(function(me){
      if(!me){ writeToken(null); session = null; renderAuth(); return; }
      // Keep the whole payload: the profile drawer edits personalPronouns,
      // identityFlags and displayEmoji, which all live on this object.
      session = { id: me.accountId, name: me.displayName || ('player ' + me.accountId), me: me };
      renderAuth();
      if(me.accountId) loadBio(t, me.accountId);
      if(profileOpen()) fillProfile();
    })
    .catch(function(){ writeToken(null); session = null; renderAuth(); });
}

/* Bio is not part of /acc/account/me - it has its own endpoint. */
function loadBio(t, accountId){
  return fetch('/acc/account/' + accountId + '/bio', { headers: { 'Authorization': 'Bearer ' + t } })
    .then(function(r){ return r.ok ? r.json() : null; })
    .then(function(j){ if(j && session) session.bio = j.bio || ''; })
    .catch(function(){});
}

function renderAuth(){
  var a = document.getElementById('authArea');
  if(!session){
    a.innerHTML = '<button class="pill ghost" onclick="openLogin()">Login</button>' +
                  '<button class="pill solid" onclick="show(\'rooms\')">Download</button>';
    return;
  }
  a.innerHTML =
    '<div class="whoami" onclick="openProfile()" title="Edit your profile">' +
      '<div class="avatar">' + esc(session.name.charAt(0)) + '</div>' +
      '<div><div class="nm">' + esc(session.name) + '</div>' +
      '<div class="rl">logged in &middot; edit profile</div></div>' +
    '</div>' +
    '<button class="pill ghost" onclick="logout()">Log out</button>';
}

/* =========================================================== profile ======
   Edits the same fields the game client writes, through the endpoints it
   already uses - there is no separate site-side profile store:

     emoji      PUT /acc/account/me/emoji            (form: displayEmoji)
     bio        PUT /acc/account/me/bio              (form: bio, <=500)
     pronouns   PUT /acc/account/me/personalpronouns(form: personalPronouns)
     sexuality  PUT /acc/account/me/identityflags    (form: identityFlags)

   Pronouns and sexuality are bitmasks on the wire, not free text. The option
   names and their order come from the client's own metadata - two consecutive
   runs in global-metadata.dat:

     SheHer HeHim TheyThem ZeHir ZeZir XeXem
     LGBTQIA Transgender Bisexual Lesbian Pansexual Asexual Intersex
     Genderqueer Nonbinary Aromantic

   Six pronouns against the server's own six-bit check on personalPronouns
   (`personalPronouns & ~0x3F`) is what says these are bit-per-option rather
   than sequential values. The raw number is shown under each group so a wrong
   guess is obvious in-game rather than silent. */
var PRONOUNS = [
  { label: 'she/her',   bit: 1 },
  { label: 'he/him',    bit: 2 },
  { label: 'they/them', bit: 4 },
  { label: 'ze/hir',    bit: 8 },
  { label: 'ze/zir',    bit: 16 },
  { label: 'xe/xem',    bit: 32 }
];

var FLAGS = [
  { label: 'LGBTQIA+',    bit: 1 },
  { label: 'Transgender', bit: 2 },
  { label: 'Bisexual',    bit: 4 },
  { label: 'Lesbian',     bit: 8 },
  { label: 'Pansexual',   bit: 16 },
  { label: 'Asexual',     bit: 32 },
  { label: 'Intersex',    bit: 64 },
  { label: 'Genderqueer', bit: 128 },
  { label: 'Nonbinary',   bit: 256 },
  { label: 'Aromantic',   bit: 512 }
];

function profileOpen(){
  var d = document.getElementById('pdrawer');
  return d && d.classList.contains('open');
}

function openProfile(){
  if(!session) return;
  fillProfile();
  document.getElementById('pscrim').classList.add('open');
  document.getElementById('pdrawer').classList.add('open');
  setTimeout(function(){
    var e = document.getElementById('pEmoji');
    if(e) e.focus();
  }, 0);
}

function closeProfile(){
  document.getElementById('pscrim').classList.remove('open');
  document.getElementById('pdrawer').classList.remove('open');
}

function chipMarkup(containerId, options, value){
  var html = '';
  for(var i = 0; i < options.length; i++){
    var on = (value & options[i].bit) !== 0;
    html += '<button type="button" class="chip' + (on ? ' on' : '') + '"' +
            ' data-cid="' + containerId + '" data-bit="' + options[i].bit + '"' +
            ' onclick="toggleChip(this)">' + esc(options[i].label) + '</button>';
  }
  document.getElementById(containerId).innerHTML = html;
}

function toggleChip(el){
  el.classList.toggle('on');
  var v = chipValue(el.getAttribute('data-cid'),
                    el.getAttribute('data-cid') === 'pPronouns' ? PRONOUNS : FLAGS);
  var raw = document.getElementById(el.getAttribute('data-cid') === 'pPronouns'
                                    ? 'pPronounsRaw' : 'pFlagsRaw');
  if(raw) raw.textContent = String(v);
}

function chipValue(containerId, options){
  var v = 0;
  var nodes = document.querySelectorAll('#' + containerId + ' .chip.on');
  for(var i = 0; i < nodes.length; i++){
    v |= parseInt(nodes[i].getAttribute('data-bit'), 10);
  }
  return v;
}

function fillProfile(){
  var me = (session && session.me) || {};
  var emoji = document.getElementById('pEmoji');
  if(emoji) emoji.value = me.displayEmoji || '';

  var bio = document.getElementById('pBio');
  if(bio){
    bio.value = (session && session.bio) || '';
    countBio();
  }

  var pr = me.personalPronouns || 0;
  var fl = me.identityFlags || 0;
  chipMarkup('pPronouns', PRONOUNS, pr);
  chipMarkup('pFlags', FLAGS, fl);
  var praw = document.getElementById('pPronounsRaw');
  if(praw) praw.textContent = String(pr);
  var fraw = document.getElementById('pFlagsRaw');
  if(fraw) fraw.textContent = String(fl);
}

function countBio(){
  var b = document.getElementById('pBio');
  var c = document.getElementById('pBioCount');
  if(b && c) c.textContent = String(b.value.length);
}

function profileNote(msg, bad){
  var n = document.getElementById('pNote');
  if(!n) return;
  n.textContent = msg;
  n.className = 'pmeta' + (bad ? ' bad' : '');
}

function saveField(which){
  var t = readToken();
  if(!t){ profileNote('Not logged in.', true); return; }

  var path, key, value, label;

  if(which === 'emoji'){
    path = '/acc/account/me/emoji'; key = 'displayEmoji'; label = 'Emoji';
    value = document.getElementById('pEmoji').value.trim();
    // The endpoint 400s on an empty value, so say so rather than letting it
    // fail with a bare "invalid_displayEmoji".
    if(!value){ profileNote('Emoji cannot be blank.', true); return; }
  } else if(which === 'bio'){
    path = '/acc/account/me/bio'; key = 'bio'; label = 'Bio';
    value = document.getElementById('pBio').value;
  } else if(which === 'pronouns'){
    path = '/acc/account/me/personalpronouns'; key = 'personalPronouns';
    label = 'Pronouns';
    value = String(chipValue('pPronouns', PRONOUNS));
  } else {
    path = '/acc/account/me/identityflags'; key = 'identityFlags';
    label = 'Sexuality';
    value = String(chipValue('pFlags', FLAGS));
  }

  var body = new URLSearchParams();
  body.set(key, value);

  profileNote(label + ': saving...');

  fetch(path, {
    method: 'PUT',
    headers: {
      'Authorization': 'Bearer ' + t,
      'Content-Type': 'application/x-www-form-urlencoded'
    },
    body: body.toString()
  })
  .then(function(r){
    return r.text().then(function(txt){ return { ok: r.ok, txt: txt }; });
  })
  .then(function(res){
    if(!res.ok){
      profileNote(label + ' failed: ' + res.txt.slice(0, 140), true);
      return;
    }
    profileNote(label + ' saved.');
    loadSession();
  })
  .catch(function(){ profileNote(label + ': could not reach the server.', true); });
}

/* ========================================================== comments ====== */
var openCommentBox = {};

function toggleComments(id){
  var box = document.getElementById('cbox-' + id);
  if(!box) return;

  if(box.classList.contains('open')){
    box.classList.remove('open');
    return;
  }

  box.classList.add('open');
  var body = box.querySelector('.clist');
  body.innerHTML = '<div class="cempty">Loading...</div>';

  fetch('/site/public/comments?path=' + encodeURIComponent(id))
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(!d.comments || !d.comments.length){
        body.innerHTML = '<div class="cempty">No comments yet.</div>';
        return;
      }
      body.innerHTML = d.comments.map(function(c){
        var when = '';
        try { when = new Date(c.createdAt).toLocaleString(); } catch(e){}
        return '<div class="crow">' +
          '<div class="avatar">' + esc((c.creatorName||'?').charAt(0)) + '</div>' +
          '<div class="cb"><span class="cn">' + esc(c.creatorName || ('player ' + c.accountId)) +
          '</span><span class="ct">' + esc(when) + '</span>' +
          '<div class="cx">' + esc(c.text) + '</div></div></div>';
      }).join('');
    })
    .catch(function(){ body.innerHTML = '<div class="cempty">Could not load comments.</div>'; });
}

function postComment(id){
  var input = document.getElementById('cin-' + id);
  var text = input.value.trim();
  if(!text || !session) return;

  var t = readToken();
  fetch('/recnet/api/photos/comments', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': 'Bearer ' + t
    },
    body: JSON.stringify({ path: id, text: text })
  })
  .then(function(r){ return r.json().then(function(j){ return { ok: r.ok, j: j }; }); })
  .then(function(res){
    if(!res.ok){
      var d = res.j || {};
      alert(d.error || 'Could not post that comment.');
      return;
    }
    input.value = '';
    var box = document.getElementById('cbox-' + id);
    box.classList.remove('open');
    toggleComments(id);
  });
}

