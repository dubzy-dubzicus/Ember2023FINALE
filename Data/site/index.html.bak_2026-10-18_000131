function loadPhotos(){
  var q  = document.getElementById('q').value;
  var cr = document.getElementById('creator').value;
  var oldest = document.getElementById('sort').value === 'old';
  var onlyFiles = document.getElementById('onlyfiles').checked;

  var url = '/site/public/photos?page=' + cur + '&pageSize=' + pageSize +
            '&oldestFirst=' + oldest;
  if(onlyFiles) url += '&onlyWithImages=true';
  if(q)  url += '&search=' + encodeURIComponent(q);
  if(cr) url += '&creator=' + encodeURIComponent(cr);

  fetch(url).then(r => r.json()).then(function(d){
    total = d.total;
    var pages = Math.max(1, Math.ceil(d.total / pageSize));
    document.getElementById('pagelabel').innerHTML =
      'Page ' + d.page + ' of ' + pages + ' &middot; <b>' + d.total + '</b> records &middot; ' +
      '<b>' + d.withImages + '</b> with image files';

    if(!d.photos.length){
      document.getElementById('feed').innerHTML = '<div class="empty">No photos match that.</div>';
      return;
    }

    if(fieldMismatch(d.photos[0])){
      document.getElementById('feed').innerHTML =
        '<div class="empty">API field names do not match this page &mdash; expected ' +
        '<code>imageAvailable</code> / <code>playerId</code>, got <code>' +
        esc(Object.keys(d.photos[0]).slice(0,4).join(', ')) + '</code>.</div>';
      return;
    }

    document.getElementById('feed').innerHTML = d.photos.map(function(p){
      var body = p.imageAvailable
        ? '<img class="postImg" src="' + esc(p.url) + '" alt="">'
        : '<div class="missing">This record has no image file on the server &mdash; the metadata is here, the pixels are not.</div>';

      var who = p.creatorName || ('player ' + p.playerId);
      var initial = esc(who.charAt(0));

      var cbox = session && p.commentable
        ? '<div class="cform">' +
            '<input id="cin-' + esc(p.id) + '" maxlength="300" placeholder="Add a comment...">' +
            '<button onclick="postComment(\'' + esc(p.id).replace(/'/g,"\\'") + '\')">Post</button>' +
          '</div>'
        : (session
            ? '<div class="cempty">Comments are closed on this photo.</div>'
            : '');

      // The server only accepts comments on photos with SavedImageType 1 and
      // Accessibility 1, so the affordance is only offered where it will work.
      var commentLink = p.commentable
        ? '<span class="comments" style="cursor:pointer" ' +
          'onclick="toggleComments(\'' + esc(p.id).replace(/'/g,"\\'") + '\')">' +
          (p.commentCount || 0) + ' comments</span>'
        : '<span class="comments">' + (p.commentCount || 0) + ' comments</span>';

      var foot = '<span class="cheer">' + p.cheerCount + ' cheers</span>' + commentLink +
                 (session || p.commentCount ? '' :
                   '<span class="comments">Log in to view comments for this photo</span>');

      return '<article class="post">' +
        '<div class="postHead">' +
          '<div class="avatar">' + initial + '</div>' +
          '<div><div class="who">' + esc(who) + '</div>' +
          '<div class="atwho">' + esc(p.roomName ? '@' + p.roomName : '@ember') + '</div></div>' +
          '<button class="share" title="Share">&#8599;</button>' +
        '</div>' + body +
        '<div class="postFoot">' + foot + '</div>' +
        '<div class="cbox" id="cbox-' + esc(p.id) + '">' +
          '<div class="clist"></div>' + cbox +
        '</div>' +
      '</article>';
    }).join('');
  }).catch(function(){
    document.getElementById('feed').innerHTML = '<div class="empty">Could not load photos.</div>';
  });
}

