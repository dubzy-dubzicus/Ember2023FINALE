<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ember</title>
<style>
/* Layout modelled on the Rec Room site: dark shell, red notice bar, a row of
   hero cards, small pill filters, then a narrow room rail beside a wide photo
   feed. Ember orange is kept as the accent.

   Nothing animates - the global reset below kills transitions and animations
   so the page is completely still. */
:root{
  /* Gradient sampled straight out of the Ember mark: a vertical magenta ->
     purple -> blue -> cyan ramp. Left/right colours match at every scanline,
     so it is a top-to-bottom gradient, not diagonal. */
  --g1:#ff3ef1;   /* 0%   hot magenta */
  --g3:#c264ea;   /* 25%  purple */
  --g5:#7793e3;   /* 50%  periwinkle */
  --g7:#46b2d9;   /* 75%  sky */
  --g8:#09dbdb;   /* 100% cyan */

  --bg:#14141d;
  --bg2:#1a1a26;
  --bar:#22222f;
  --panel:#1e1e2a;
  --card:#262634;
  --line:#37374a;
  --line2:#4a4a63;
  --ink:#f4f2fb;
  --muted:#a9a4c4;
  --dim:#7b769a;

  --accent:#b26ee7;        /* mid purple - legible as text/border on dark */
  --accent-hot:#ff3ef1;
  --accent-cool:#09dbdb;
  --on-accent:#120a1c;     /* text sitting on a solid accent fill */
  --notice:#9b2fd0;
  --ok:#3ddc97;

  --ember:linear-gradient(150deg,var(--g1),var(--g3) 45%,var(--g8));
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
/* No motion anywhere. */
*,*::before,*::after{animation:none!important;transition:none!important}
body{
  background:var(--bg);
  color:var(--ink);
  font:15px/1.5 "Segoe UI",system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;
  min-height:100vh;
}
a{color:var(--accent);text-decoration:none}
button{font-family:inherit}

/* ---------------------------------------------------------------- top bar */
.topbar{
  background:var(--bar);
  border-bottom:1px solid #0e0e16;
  display:flex;
  align-items:center;
  gap:16px;
  padding:10px 20px;
}
.brand{
  display:flex;align-items:center;gap:9px;
  font-weight:700;font-size:17px;letter-spacing:.06em;
  color:var(--ink);
}
.brand .mark{
  width:26px;height:26px;border-radius:6px;
  background:var(--ember);
  display:grid;place-items:center;
  font-size:14px;color:var(--on-accent);font-weight:800;
}
.navlinks{display:flex;gap:6px;margin-left:4px}
.navlinks a{
  color:var(--muted);
  font-size:13.5px;font-weight:600;
  padding:6px 11px;border-radius:7px;
}
.navlinks a:hover{color:var(--ink);background:#2e2e40}
.topright{margin-left:auto;display:flex;align-items:center;gap:9px}
/* #authArea is a flex ITEM of .topright, but its own children (the signed-in
   block and the Log out button) are siblings. Left as a block they stacked
   vertically and the Log out button dropped onto its own line under the
   username. It has to be a flex row itself. */
#authArea{display:flex;align-items:center;gap:10px}
.iconbtn{
  width:32px;height:32px;border-radius:7px;
  background:#2e2e40;border:1px solid var(--line);
  color:var(--muted);cursor:pointer;font-size:15px;
  display:grid;place-items:center;
}
.pill{
  border-radius:8px;padding:7px 14px;
  font-size:13.5px;font-weight:600;cursor:pointer;
}
.pill.ghost{background:transparent;border:1px solid var(--accent);color:var(--accent)}
.pill.solid{background:var(--accent);border:1px solid var(--accent);color:var(--on-accent)}
.pill.solid:hover{background:var(--accent-hot);border-color:var(--accent-hot);color:var(--on-accent)}

/* ----------------------------------------------------------- notice bar */
.notice{
  background:var(--notice);
  padding:11px 20px;
  display:flex;align-items:center;gap:12px;
  font-size:13.5px;
}
.notice .gift{
  width:26px;height:26px;flex:0 0 26px;border-radius:6px;
  background:rgba(255,255,255,.16);
  display:grid;place-items:center;font-size:14px;
}
.notice .txt{flex:1;max-width:900px;margin:0 auto;width:100%}
.notice .x{
  background:transparent;border:0;color:#fff;cursor:pointer;
  font-size:17px;line-height:1;padding:4px 8px;opacity:.85;
}

/* ------------------------------------------------------------------ hero */
.hero{
  background:var(--bg2);
  border-bottom:1px solid var(--line);
  padding:26px 20px 22px;
}
.herowrap{max-width:980px;margin:0 auto}
.herorow{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.heroCard{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:10px;
  overflow:hidden;
  display:block;
}
.heroArt{
  height:150px;
  display:grid;place-items:center;
  text-align:center;
  padding:12px;
}
.heroArt .big{font-size:38px;font-weight:800;letter-spacing:.02em;line-height:1}
.heroArt .lbl{
  display:block;font-size:12px;letter-spacing:.14em;
  text-transform:uppercase;opacity:.92;margin-top:6px;font-weight:600;
}
.heroCap{
  padding:11px 13px;font-size:13.5px;font-weight:600;
  display:flex;align-items:center;justify-content:space-between;gap:8px;
  color:var(--ink);
}
.heroCap .go{color:var(--accent);font-size:12px}

/* ----------------------------------------------------------------- pills */
.pills{display:flex;gap:9px;justify-content:center;padding:16px 20px 4px}
.fpill{
  background:transparent;
  border:1px solid var(--accent);
  color:var(--accent);
  border-radius:999px;
  padding:6px 16px;
  font-size:13px;font-weight:600;
  cursor:pointer;
  display:flex;align-items:center;gap:6px;
}
.fpill.on{background:var(--accent);color:var(--on-accent)}

/* --------------------------------------------------------------- controls */
.controls{
  max-width:980px;margin:0 auto;
  display:flex;gap:10px;flex-wrap:wrap;align-items:center;
  padding:14px 20px 4px;
}
input[type=search],select{
  background:#21212e;
  border:1px solid var(--line2);
  color:var(--ink);
  padding:8px 12px;border-radius:8px;font-size:14px;
}
input[type=search]{min-width:230px}
.toggle{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:13px;cursor:pointer}
.toggle input{accent-color:var(--accent);width:14px;height:14px;cursor:pointer}
.statline{
  max-width:980px;margin:0 auto;padding:0 20px 4px;
  color:var(--dim);font-size:12.5px;
}
.statline b{color:var(--muted);font-weight:600}

/* ------------------------------------------------------------------ body */
.cols{
  max-width:980px;margin:0 auto;
  display:grid;grid-template-columns:212px 1fr;
  gap:22px;
  padding:18px 20px 60px;
  align-items:start;
}
.railhead,.feedhead{font-size:15.5px;font-weight:700;margin:0 0 11px}

.rail{display:flex;flex-direction:column;gap:12px}
.roomCard{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:9px;overflow:hidden;
}
.roomArt{
  aspect-ratio:4/3;
  display:grid;place-items:center;
  color:var(--dim);font-size:12px;text-align:center;padding:8px;
  background:#21212e;
}
.roomArt img{width:100%;height:100%;object-fit:cover;display:block}
.roomMeta{padding:8px 10px}
.roomName{
  font-size:13px;font-weight:600;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.roomSub{color:var(--dim);font-size:11.5px;margin-top:2px}

.feed{display:flex;flex-direction:column;gap:18px}
.post{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:10px;overflow:hidden;
}
.postHead{
  display:flex;align-items:center;gap:9px;
  padding:10px 12px;
}
.avatar{
  width:30px;height:30px;border-radius:6px;flex:0 0 30px;
  background:var(--ember);
  display:grid;place-items:center;
  font-size:12px;font-weight:700;color:var(--on-accent);
  text-transform:uppercase;
}
.who{font-size:13.5px;font-weight:700;line-height:1.25}
.atwho{font-size:11.5px;color:var(--dim)}
.share{
  margin-left:auto;background:transparent;border:0;
  color:var(--muted);cursor:pointer;font-size:15px;padding:4px 6px;
}
.postImg{background:#101018;display:block;width:100%}
.postFoot{
  padding:10px 12px;
  display:flex;align-items:center;gap:16px;
  font-size:12.5px;color:var(--muted);
}
.postFoot .cheer{color:var(--ink);font-weight:600}
.postFoot .comments{color:var(--dim)}
.missing{
  background:var(--panel);
  border:1px dashed var(--line2);
  border-radius:8px;
  color:var(--dim);
  font-size:12.5px;
  padding:10px 12px;margin:0 20px 16px;
}
.empty{color:var(--dim);padding:40px 0;text-align:center;font-size:14px}

/* ------------------------------------------------------------- login modal */
.scrim{
  position:fixed;inset:0;background:rgba(0,0,0,.66);
  display:none;place-items:center;z-index:50;
}
.scrim.open{display:grid}
.modal{
  width:340px;max-width:92vw;
  background:var(--panel);
  border:1px solid var(--line2);
  border-radius:10px;
  padding:22px;
}
.modal h3{margin:0 0 4px;font-size:17px}
.modal p.hint{color:var(--dim);font-size:12.5px;margin:0 0 16px}
.field{margin-bottom:12px}
.field label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px}
.field input{
  width:100%;
  background:#15151f;
  border:1px solid var(--line2);
  color:var(--ink);
  padding:9px 11px;border-radius:7px;font-size:14px;
}
.field input:focus{outline:none;border-color:var(--accent)}
.err{
  display:none;
  background:rgba(255,62,241,.12);
  border:1px solid rgba(255,62,241,.45);
  color:#ff9ae4;
  border-radius:7px;padding:8px 10px;font-size:12.5px;margin-bottom:12px;
}
.err.show{display:block}
.modal .row{display:flex;gap:9px;margin-top:16px}
.modal .row .pill{flex:1;text-align:center}

/* who is logged in */
.whoami{display:flex;align-items:center;gap:9px}
.whoami .avatar{width:28px;height:28px;flex:0 0 28px;font-size:12px}
.whoami .nm{font-size:13.5px;font-weight:700;line-height:1.1}
.whoami .rl{font-size:11px;color:var(--dim)}

/* ---------------------------------------------------------- comment drawer */
.cbox{border-top:1px solid var(--line);padding:11px 12px;display:none}
.cbox.open{display:block}
.cbox .cempty{color:var(--dim);font-size:12.5px}
.crow{display:flex;gap:9px;margin-bottom:10px}
.crow .avatar{width:24px;height:24px;flex:0 0 24px;font-size:11px;border-radius:5px}
.crow .cb{font-size:13px;line-height:1.4}
.crow .cn{font-weight:700;font-size:12.5px}
.crow .ct{color:var(--dim);font-size:11px;margin-left:6px;font-weight:400}
.crow .cx{color:var(--ink)}
.cform{display:flex;gap:8px;margin-top:10px}
.cform input{
  flex:1;background:#15151f;border:1px solid var(--line2);
  color:var(--ink);padding:8px 11px;border-radius:7px;font-size:13px;
}
.cform input:focus{outline:none;border-color:var(--accent)}
.cform button{
  background:var(--accent);border:0;color:var(--on-accent);font-weight:700;
  padding:8px 14px;border-radius:7px;cursor:pointer;font-size:13px;
}
.cform button:disabled{opacity:.5;cursor:default}

/* ---------------------------------------------------------- profile drawer */
.whoami{cursor:pointer;border-radius:8px;padding:3px 6px;margin:-3px -6px;transition:background .12s}
.whoami:hover{background:rgba(255,255,255,.06)}
.pscrim{
  position:fixed;inset:0;background:rgba(0,0,0,.6);opacity:0;pointer-events:none;
  transition:opacity .16s;z-index:60;
}
.pscrim.open{opacity:1;pointer-events:auto}
.pdrawer{
  position:fixed;top:0;right:0;height:100%;width:min(420px,94vw);
  background:var(--panel);border-left:1px solid var(--line2);
  transform:translateX(102%);transition:transform .18s ease;z-index:61;
  display:flex;flex-direction:column;
}
.pdrawer.open{transform:translateX(0)}
.phead{
  display:flex;align-items:center;justify-content:space-between;
  padding:16px 18px;border-bottom:1px solid var(--line);
}
.phead h3{margin:0;font-size:15px;letter-spacing:.02em}
.phead .x{
  background:none;border:0;color:var(--dim);font-size:24px;line-height:1;
  cursor:pointer;padding:0 4px;
}
.phead .x:hover{color:var(--ink)}
.pbody{padding:18px;overflow-y:auto;flex:1}
.prow{margin-bottom:22px}
.prow label{
  display:block;font-size:11px;letter-spacing:.09em;text-transform:uppercase;
  color:var(--dim);margin-bottom:7px;font-weight:700;
}
.prow input[type=text],.prow textarea{
  width:100%;background:#15151f;border:1px solid var(--line2);color:var(--ink);
  padding:9px 11px;border-radius:7px;font-size:13.5px;font-family:inherit;
}
.prow textarea{resize:vertical;line-height:1.5}
.prow input[type=text]:focus,.prow textarea:focus{outline:none;border-color:var(--accent)}
.phint{color:var(--dim);font-size:11.5px;margin:6px 0 9px;line-height:1.45}
.phint code{background:#15151f;padding:1px 5px;border-radius:4px;font-size:11px}
.pchips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:9px}
.chip{
  background:#15151f;border:1px solid var(--line2);color:var(--dim);
  padding:6px 11px;border-radius:999px;font-size:12.5px;cursor:pointer;
  font-family:inherit;transition:all .12s;
}
.chip:hover{border-color:var(--accent);color:var(--ink)}
.chip.on{background:var(--accent);border-color:var(--accent);color:var(--on-accent);font-weight:700}
.prow .pill{margin-top:2px}
.pmeta{color:var(--dim);font-size:11.5px;margin:8px 0 0;min-height:14px}
.pmeta.bad{color:#ff8a8a}

footer{
  border-top:1px solid var(--line);
  padding:18px 20px;
  text-align:center;
  color:var(--dim);font-size:12.5px;
}
</style>
</head>
<body>

<div class="topbar">
  <div class="brand"><span class="mark">E</span> Ember</div>
  <div class="navlinks">
    <a href="#" onclick="show('photos');return false">Photos</a>
    <a href="#" onclick="show('rooms');return false">Rooms</a>
  </div>
  <div class="topright">
    <button class="iconbtn" title="Search" onclick="focusSearch()">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
           stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <line x1="15.4" y1="15.4" x2="21" y2="21"></line>
      </svg>
    </button>
    <div id="authArea"></div>
  </div>
</div>

<div class="notice" id="notice">
  <span class="gift">&#127873;</span>
  <p class="txt" id="noticeTxt"></p>
  <button class="x" onclick="document.getElementById('notice').style.display='none'">&times;</button>
</div>

<!-- ================================================= profile drawer ==== -->
<div class="pscrim" id="pscrim" onclick="closeProfile()"></div>
<aside class="pdrawer" id="pdrawer" aria-label="Your profile">
  <div class="phead">
    <h3>Your profile</h3>
    <button class="x" onclick="closeProfile()" title="Close">&times;</button>
  </div>

  <div class="pbody">
    <div class="prow">
      <label for="pEmoji">Emoji</label>
      <input id="pEmoji" type="text" maxlength="16" placeholder="&#128054;" autocomplete="off">
      <p class="phint">Up to 16 characters. Shown next to your name everywhere.</p>
      <button class="pill solid" onclick="saveField('emoji')">Save emoji</button>
    </div>

    <div class="prow">
      <label for="pBio">Bio</label>
      <textarea id="pBio" rows="4" maxlength="500"
                placeholder="Say something about yourself"
                oninput="countBio()"></textarea>
      <p class="phint"><span id="pBioCount">0</span>/500</p>
      <button class="pill solid" onclick="saveField('bio')">Save bio</button>
    </div>

    <div class="prow">
      <label>Pronouns</label>
      <div class="pchips" id="pPronouns"></div>
      <p class="phint">Sent as <code>personalPronouns</code> = <code id="pPronounsRaw">0</code></p>
      <button class="pill solid" onclick="saveField('pronouns')">Save pronouns</button>
    </div>

    <div class="prow">
      <label>Sexuality</label>
      <div class="pchips" id="pFlags"></div>
      <p class="phint">Sent as <code>identityFlags</code> = <code id="pFlagsRaw">0</code></p>
      <button class="pill solid" onclick="saveField('flags')">Save sexuality</button>
    </div>

    <p class="pmeta" id="pNote"></p>
  </div>
</aside>

<div class="hero">
  <div class="herowrap">
    <div class="herorow">
      <a class="heroCard" href="#" onclick="show('photos');return false">
        <div class="heroArt" style="background:linear-gradient(160deg,#ff3ef1,#c264ea)">
          <div><span class="big" id="heroPhotos">0</span><span class="lbl">Photos</span></div>
        </div>
        <div class="heroCap"><span>View the gallery</span><span class="go">&#8250;</span></div>
      </a>
      <a class="heroCard" href="#" onclick="show('rooms');return false">
        <div class="heroArt" style="background:linear-gradient(160deg,#c264ea,#7793e3)">
          <div><span class="big" id="heroRooms">0</span><span class="lbl">Rooms</span></div>
        </div>
        <div class="heroCap"><span>Browse every room</span><span class="go">&#8250;</span></div>
      </a>
      <a class="heroCard" href="#" onclick="show('creators');return false">
        <div class="heroArt" style="background:linear-gradient(160deg,#7793e3,#09dbdb)">
          <div><span class="big" id="heroCreators">0</span><span class="lbl">Accounts</span></div>
        </div>
        <div class="heroCap"><span>See who made them</span><span class="go">&#8250;</span></div>
      </a>
    </div>
  </div>
</div>

<div class="pills">
  <button class="fpill on" id="pill-photos" onclick="show('photos')">&#9679; Photos</button>
  <button class="fpill" id="pill-rooms" onclick="show('rooms')">&#9679; Rooms</button>
  <button class="fpill" id="pill-creators" onclick="show('creators')">&#9679; Creators</button>
</div>

<div class="controls">
  <input type="search" id="q" placeholder="Search&hellip;" oninput="loadPhotos()">
  <select id="creator" onchange="loadPhotos()"><option value="">All creators</option></select>
  <select id="sort" onchange="loadPhotos()">
    <option value="new">Newest first</option>
    <option value="old">Oldest first</option>
  </select>
  <label class="toggle"><input type="checkbox" id="onlyfiles" onchange="loadPhotos()"> Only photos with image files</label>
  <span class="statline" id="pagelabel"></span>
</div>

<div class="cols">
  <section>
    <h2 class="railhead">Featured Rooms</h2>
    <div class="rail" id="rail"></div>
  </section>
  <section>
    <h2 class="feedhead" id="feedhead">Take A Look At What's Happening Right Now In Ember</h2>
    <div class="feed" id="feed"></div>
  </section>
</div>

<footer>Ember &mdash; served by the Ember API. Photos and rooms read live from the server database.</footer>

<div class="scrim" id="scrim" onclick="if(event.target===this)closeLogin()">
  <div class="modal">
    <h3>Log in to Ember</h3>
    <p class="hint">Use your Rec Room account on this server.</p>
    <div class="err" id="loginErr"></div>
    <div class="field">
      <label for="lu">Username</label>
      <input id="lu" autocomplete="username" autocapitalize="none" spellcheck="false">
    </div>
    <div class="field">
      <label for="lp">Password</label>
      <input id="lp" type="password" autocomplete="current-password">
    </div>
    <div class="row">
      <button class="pill ghost" onclick="closeLogin()">Cancel</button>
      <button class="pill solid" id="loginBtn" onclick="doLogin()">Log in</button>
    </div>
  </div>
</div>

<script>
var cur = 1, total = 0, pageSize = 24, tab = 'photos';

function esc(s){
  return String(s==null?'':s).replace(/[&<>"']/g, function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}

function show(which){
  tab = which;
  cur = 1;
  ['photos','rooms','creators'].forEach(function(k){
    document.getElementById('pill-' + k).className = 'fpill' + (k === which ? ' on' : '');
  });

  document.getElementById('feedhead').textContent =
    which === 'rooms' ? 'Rooms On This Server'
    : which === 'creators' ? 'Accounts On This Server'
    : "Take A Look At What's Happening Right Now In Ember";

  document.querySelector('.controls').style.display = which === 'photos' ? '' : 'none';

  if(which === 'photos') loadPhotos();
  else if(which === 'rooms') loadRooms();
  else loadCreatorsList();
}

/* Guard against a server/page field-name mismatch. This page originally read
   p.imageAvailable while the server emitted "ImageAvailable", so every value
   came through undefined, no <img> tags were ever created and every card read
   "by @undefined". Failing loudly beats a plausible page that is quietly empty. */
function fieldMismatch(p){
  return p && p.imageAvailable === undefined && p.ImageAvailable === undefined;
}

function loadSummary(){
  fetch('/site/public/summary').then(r => r.json()).then(function(s){
    document.getElementById('heroPhotos').textContent   = s.photos;
    document.getElementById('heroRooms').textContent    = s.rooms;
    document.getElementById('heroCreators').textContent = s.creators;

    document.getElementById('noticeTxt').innerHTML = s.photosMissing > 0
      ? 'This server hosts <b>' + s.photos + '</b> photo records, but <b>' + s.photosMissing +
        '</b> of them have no image file &mdash; the metadata shipped without the pixels. ' +
        'Those show a placeholder. Photos taken in-game save normally.'
      : 'Ember is up with <b>' + s.rooms + '</b> rooms, <b>' + s.creators +
        '</b> accounts and <b>' + s.photos + '</b> photos, all with image files. ' +
        'No account needed to browse.';
