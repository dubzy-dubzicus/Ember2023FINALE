async function loadRooms() {
    const grid = document.getElementById('roomsGrid');
    grid.innerHTML = '<div class="empty-state"><h2>Loading rooms...</h2><p class="no-data">Fetching room data from server...</p></div>';

    try {
        const resp = await fetch('/api/rooms/v1/all');
        console.log('[home] API response status:', resp.status, resp.statusText);
        const raw = await resp.text();
        console.log('[home] raw API response:', raw);
        if (!resp.ok) {
            throw new Error(`HTTP ${resp.status}: ${raw}`);
        }
        const data = JSON.parse(raw);
        console.log('[home] parsed rooms:', data);
        grid.innerHTML = '';

        if (!Array.isArray(data) || data.length === 0) {
            grid.innerHTML = '<div class="empty-state"><h2>No rooms found</h2><p class="no-data">No rooms are currently available.</p></div>';
            return;
        }

        data.forEach(room => {
            const card = document.createElement('div');
            card.className = 'room-card';
            const name = (room && room.name) ? room.name : 'Unnamed Room';
            const description = (room && room.description) ? room.description : 'No description available';
            const maxPlayers = (room && room.maxPlayers != null) ? room.maxPlayers : 20;
            const imageName = (room && room.imageName) ? room.imageName : '';
            const ownerName = (room && room.ownerName) ? room.ownerName : 'unknown';
            const imgSrc = imageName ? `/cdn/room/${encodeURIComponent(imageName)}` : 'https://via.placeholder.com/400x220/333333/ffffff?text=Room+Image';
            card.innerHTML = `
                <img src="${imgSrc}" alt="${name}" onerror="this.src='https://via.placeholder.com/400x220/333333/ffffff?text=Room+Image'">
                <div class="room-card-content">
                    <h3>${name}</h3>
                    <p>${description}</p>
                    <div class="room-stats">
                        <span>${maxPlayers} capacity</span>
                        <span>By ${ownerName}</span>
                    </div>
                </div>
            `;
            grid.appendChild(card);
        });
    } catch (e) {
        console.error('[home] failed to load rooms:', e);
        grid.innerHTML = `<div class="empty-state"><h2>Error loading rooms</h2><p class="no-data">${e.message}</p></div>`;
    }
}

loadRooms();