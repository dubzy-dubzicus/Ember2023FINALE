async function loadRoom() {
    try {
        const roomId = window.location.pathname.split('/').pop();
        const resp = await fetch(`/api/web/rooms/v1/${encodeURIComponent(roomId)}`);
        console.log('[room] API response status:', resp.status);
        const raw = await resp.text();
        console.log('[room] raw API response:', raw);
        if (!resp.ok) {
            throw new Error(`HTTP ${resp.status}: ${raw}`);
        }
        const data = JSON.parse(raw);
        console.log('[room] parsed room data:', data);

        document.getElementById('roomTitle').textContent = data.name || 'Unknown Room';
        document.getElementById('roomOwnerName').textContent = data.ownerName || 'Unknown';
        document.getElementById('roomOwner').textContent = 'Owner: ' + (data.ownerName || 'Unknown');
        document.getElementById('roomIdDisplay').textContent = data.roomId || 'unknown';
        document.getElementById('roomCapacity').textContent = data.maxPlayers ?? 20;
        document.getElementById('roomDescription').innerHTML = `<p>${data.description || 'No description available'}</p>`;

        const tagsContainer = document.getElementById('roomTags');
        tagsContainer.innerHTML = '';
        (data.tags || []).forEach(tag => {
            const el = document.createElement('span');
            el.className = 'tag';
            el.textContent = tag;
            tagsContainer.appendChild(el);
        });

        const playersContainer = document.getElementById('roomPlayers');
        const players = data.players || [];
        if (players.length === 0) {
            playersContainer.innerHTML = '<p class="no-data">No players online right now.</p>';
        } else {
            playersContainer.innerHTML = '';
            players.forEach(p => {
                const el = document.createElement('div');
                el.className = 'room-player';
                el.textContent = p.displayName || p.username || 'Unknown';
                playersContainer.appendChild(el);
            });
        }
    } catch (e) {
        console.error('[room] failed to load room details:', e);
        document.getElementById('roomTitle').textContent = 'Room Not Found';
        document.getElementById('roomDescription').innerHTML = '<p>Unable to load room details.</p>';
    }
}

loadRoom();
